{
  "expo": {
    "name": "Hubber",
    "slug": "hubber",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hubber",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "ios": {
      "bundleIdentifier": "io.hubberapp.app",
      "supportsTablet": false
    },
    "android": {
      "package": "io.hubberapp.app",
      "adaptiveIcon": {
        "backgroundColor": "#2F5D50",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-localization",
        {
          "supportedLocales": ["nb", "en"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100,
          "dark": {
            "backgroundColor": "#121413"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hubber uses your photos so you can share them in chats and choose a profile picture.",
          "cameraPermission": "Hubber uses the camera so you can take photos to share in chats.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F5D50"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/dff3f4cb-e5dd-42b0-ba6a-141b4880b216"
    },
    "extra": {
      "eas": {
        "projectId": "dff3f4cb-e5dd-42b0-ba6a-141b4880b216"
      }
    }
  }
}
